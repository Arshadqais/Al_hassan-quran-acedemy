# Copy to .env and enter private values on your academy server. Never commit .env.
DATABASE_USER=academy
DATABASE_PASSWORD=
DATABASE_HOST=127.0.0.1
DATABASE_PORT=5432
DATABASE_NAME=quran_academy
ACADEMY_ORIGINS=https://arshadqais.github.io
# Optional private classroom service; values remain on the backend only.
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Optional WhatsApp Business reminders. Use: python3 scripts/local.py configure-whatsapp
# Tokens remain on the backend only. Recipients must opt in from their account.
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_WABA_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_TEMPLATE_NAME=
WHATSAPP_TEMPLATE_LANGUAGE=en
WHATSAPP_API_VERSION=v23.0
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
REMINDER_MINUTES=10
REMINDER_TIMEZONE=Asia/Karachi
